<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="16dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="🌊 Magic Ocean Tile Bot"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <!-- Status Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#1E1E1E"
        android:padding="14dp"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tv_acc_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Aksesibilitas: Belum Aktif"
            android:textColor="#FF5252"
            android:textSize="14sp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tv_bot_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Status Bot: NONAKTIF"
            android:textColor="#B0BEC5"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Tombol Aksi Utama -->
    <Button
        android:id="@+id/btn_toggle_bot"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="▶ MULAI BOT SEKARANG"
        android:backgroundTint="#00E676"
        android:textColor="#000000"
        android:textStyle="bold"
        android:textSize="15sp"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btn_open_settings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Izin Aksesibilitas"
            android:backgroundTint="#0288D1"
            android:textColor="#FFFFFF"
            android:layout_marginEnd="4dp" />

        <Button
            android:id="@+id/btn_toggle_overlay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Tombol Melayang"
            android:backgroundTint="#455A64"
            android:textColor="#FFFFFF"
            android:layout_marginStart="4dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_open_game"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Buka Game Magic Ocean"
        android:backgroundTint="#37474F"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="12dp" />

    <!-- Log Console -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Log Aktivitas Bot (Real-time):"
        android:textColor="#B0BEC5"
        android:textSize="12sp"
        android:layout_marginBottom="4dp" />

    <ScrollView
        android:id="@+id/scroll_logs"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#0A0A0A"
        android:padding="8dp">

        <TextView
            android:id="@+id/tv_logs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#00E676"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:text="[System] Aplikasi siap digunakan.\n" />
    </ScrollView>

</LinearLayout>
