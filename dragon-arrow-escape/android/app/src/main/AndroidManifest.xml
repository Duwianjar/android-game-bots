<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- ========== PERMISSIONS ========== -->
    <!-- Required untuk ads -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    
    <!-- Optional tapi recommended untuk ad targeting (meningkatkan CPM) -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    
    <!-- Vibration untuk haptic feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:label="Dragon Arrow Escape"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">
        
        <!-- ========== GOOGLE MOBILE ADS CONFIGURATION ========== -->
        <!-- 
        ⚠️ PENTING: Ganti dengan App ID Production dari AdMob!
        
        CURRENT: TEST ID (TIDAK MENGHASILKAN UANG!)
        PRODUCTION: Dapatkan dari https://admob.google.com
        
        Langkah-langkah:
        1. Buat akun AdMob
        2. Daftarkan aplikasi ini
        3. Dapatkan App ID (format: ca-app-pub-XXXXXXXXXXXXXXXX~YYYYYYYYYY)
        4. Ganti value di bawah ini
        5. Juga ganti Ad Unit IDs di AdsManager.java
        -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="ca-app-pub-3940256099942544~3347511713" />
        
        <!-- Delay app measurement untuk improve app start time -->
        <meta-data
            android:name="com.google.android.gms.ads.DELAY_APP_MEASUREMENT_INIT"
            android:value="true" />
        
        <!-- Optimize initialization -->
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_INITIALIZATION"
            android:value="true" />
        
        <!-- Optimize ad loading -->
        <meta-data
            android:name="com.google.android.gms.ads.flag.OPTIMIZE_AD_LOADING"
            android:value="true" />
        
        <!-- ========== MAIN ACTIVITY ========== -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:windowSoftInputMode="adjustResize"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        
        <!-- ========== ADMOB AD ACTIVITY ========== -->
        <!-- Required untuk fullscreen ads (Rewarded & Interstitial) -->
        <activity
            android:name="com.google.android.gms.ads.AdActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|uiMode|screenSize|smallestScreenSize"
            android:theme="@android:style/Theme.Translucent" />
        
    </application>

</manifest>
